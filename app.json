{
  "expo": {
    "name": "ADIGO",
    "slug": "ADIGO",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/adigo-app-icon.png",
    "scheme": "organiccorporateapp",
    "userInterfaceStyle": "automatic",
    "ios": {},
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/adigo-app-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA"
      ],
      "package": "com.organic.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "server",
      "favicon": "./assets/images/adigo-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/adigo-logo.png",
          "imageWidth": 160,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#121614",
            "image": "./assets/images/adigo-logo.png"
          }
        }
      ],
      "expo-secure-store",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Cho phép ADIGO dùng vị trí để gợi ý địa chỉ nhận hàng."
        }
      ],
      [
        "expo-maps",
        {
          "requestLocationPermission": true,
          "locationPermission": "Cho phép ADIGO dùng vị trí để gợi ý địa chỉ nhận hàng."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Cho phép ADIGO dùng camera để quét mã QR và chụp ảnh sản phẩm khi đánh giá.",
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "c27653c9-e692-497d-9e87-f53437d7f6be"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/c27653c9-e692-497d-9e87-f53437d7f6be"
    }
  }
}
